{
	"name": "mosl/opensign-bridge-bundle",
	"description": "Symfony bundle bridging OpenSign (e-signature)",
	"type": "symfony-bundle",
	"license": "MIT",
	"require": {
		"php": ">=8.4",
		"guzzlehttp/guzzle": "^7.8",
		"rollerworks/password-strength-validator": "^3.0",
		"symfony/console": "^8.0",
		"symfony/framework-bundle": "^8.0",
		"symfony/http-kernel": "^8.0",
		"symfony/messenger": "^8.0",
		"symfony/scheduler": "^8.0",
		"symfony/validator": "^8.0",
		"symfony/yaml": "^8.0",
		"symfony/var-exporter": "^8.0"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.2",
		"symplify/easy-coding-standard": "^13.3",
		"phpunit/phpunit": "^10.5"
	},
	"autoload": {
		"psr-4": {
			"Mosl\\OpenSignBridgeBundle\\": "src/"
		}
	}
}
